# .wslconfig  —  goes on WINDOWS at %USERPROFILE%\.wslconfig
#
# Configures the WSL2 virtual machine globally (all distros). This is NOT /etc/wsl.conf,
# which lives inside WSL and configures one distro.
#
# Install (PowerShell):
#   notepad $env:USERPROFILE\.wslconfig
#   # paste the [wsl2] section below, adjust the numbers, save
#   wsl --shutdown
#
# Then verify inside WSL:
#   nproc      # should match 'processors'
#   free -h    # should match 'memory'
#
# Tune to your machine. Leave Windows at least 8 GB of RAM and a couple of cores, or everything
# outside WSL will feel worse. More processors means faster 'make -j', up to your core count.

# Sizing rule of thumb: give WSL about two thirds of RAM and cores, and leave the rest for
# Windows. On a 22-core / 31 GB host, 18 processors and 20 GB works well and still leaves
# Windows 4 cores and ~11 GB for Teams, Outlook, a browser, and the corporate security agents.

[wsl2]
memory=20GB
processors=18
swap=8GB

# Required for QEMU/KVM inside WSL2. WSL2 is itself a VM, so running a hypervisor inside it needs
# the outer hypervisor to expose VT-x/AMD-V. Default is true on Windows 11 x86; set it explicitly
# so the intent is recorded. Has no effect on ARM64 Windows, where nesting is impossible.
nestedVirtualization=true

# Milliseconds the VM may sit idle before WSL shuts it down, releasing all of its memory
# back to Windows. 60000 (60s) is already the default; stated explicitly because this is
# the setting that makes the 'memory' ceiling above harmless when you are not using WSL.
vmIdleTimeout=60000

[experimental]
# 'memory' above is a CEILING, not a reservation — Windows does not lose 20 GB while WSL
# is idle. But the Linux guest spends free RAM on page cache, and a kernel build reads
# tens of thousands of files, so the guest's footprint climbs toward that ceiling and has
# historically not shrunk back promptly. This setting hands cached memory back to Windows
# once the guest goes idle.
#
#   disabled  - never reclaim
#   gradual   - reclaim slowly (gentler on a build you are about to resume)
#   dropCache - reclaim immediately (current documented default)
#
# NOTE: this key belongs in [experimental], NOT [wsl2]. Putting it under [wsl2] produces
# "wsl: Unknown key 'wsl2.autoMemoryReclaim'" and is silently ignored.
autoMemoryReclaim=gradual
